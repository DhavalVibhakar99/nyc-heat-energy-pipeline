{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::heatwatch-nyc-raw-dhaval/raw/*"
    },
    {
      "Sid": "ListRawFolderOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::heatwatch-nyc-raw-dhaval",
      "Condition": { "StringLike": { "s3:prefix": ["raw/*"] } }
    },
    {
      "Sid": "FindBucketRegion",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::heatwatch-nyc-raw-dhaval"
    }
  ]
}